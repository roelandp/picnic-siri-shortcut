# Kopieer naar .env en zet rechten op 600: chmod 600 .env

# Picnic-account
PICNIC_USERNAME=
PICNIC_PASSWORD=
PICNIC_COUNTRY=NL
# Kanaal voor de 2FA-code bij een nieuwe login: SMS of EMAIL
PICNIC_2FA_CHANNEL=SMS

# Opslag (relatief pad is ten opzichte van de werkmap)
DATA_DIR=data

# 1 = elke response als JSON wegschrijven naar data/raw/<endpoint>/<timestamp>.json
# Handig bij explore of debuggen; voor de nachtelijke sync 0 laten
RAW_DUMP=0

# Throttle: seconden tussen calls en maximum per uur. Code houdt minimaal 1 s en maximaal 1200 per uur aan
# 1 s is de ondergrens; Picnic blokkeerde met een HTML-403 na ruim 150 artikelpagina's op 1 per s
MIN_REQUEST_INTERVAL=3.0
MAX_REQUESTS_PER_HOUR=600

LOG_LEVEL=INFO

# Alleen voor picnic explore: bekende EAN voor get_article_by_gtin (standaard Coca-Cola blik 33cl)
EXPLORE_GTIN=5449000000996

# Optioneel: Telegram-melding als de Picnic-login verlopen is. Leeg laten = geen meldingen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API voor de Shortcuts
# Lange willekeurige sleutel, bijvoorbeeld: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=
# Adres waarop de API luistert. 127.0.0.1 is alleen lokaal; zet hier het LAN-adres van de server
# (bijvoorbeeld 192.168.1.20) zodat je telefoon erbij kan. Zet de API niet open naar internet
API_HOST=127.0.0.1
API_PORT=8085
# Tempo voor de API: een paar calls per spraakopdracht, dus sneller dan explore of sync
API_MIN_REQUEST_INTERVAL=1.0

